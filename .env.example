# ==============================================================================
# OMNIWAREHOUSE MOBILE - ENVIRONMENT CONFIGURATION
# ==============================================================================
#
# Salin file ini menjadi '.env' di root folder proyek:
#   copy .env.example .env
#
# PANDUAN PENGISIAN:
# - Android Emulator : Biarkan default (http://10.0.2.2:8000/api)
# - HP Fisik / Wi-Fi  : Ganti dengan IP Wi-Fi laptop Anda (contoh: http://172.20.10.3:8000/api)
# - Production Server : Ganti dengan domain server resmi (contoh: https://wms.omniwarehouse.com/api)
# ==============================================================================

API_BASE_URL=http://10.0.2.2:8000/api
APP_ENV=local

